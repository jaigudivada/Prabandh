# ──────────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────────
PORT=5000

# ──────────────────────────────────────────────
# JWT Secret Key — REQUIRED (both local and production)
# ──────────────────────────────────────────────
# The app will crash on startup if this is missing.
#
# For local development: Copy this file to .env and set a real value.
# For Vercel production: Go to Vercel Dashboard → Settings → Environment Variables
#   and add JWT_SECRET as a secret environment variable.
#
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ──────────────────────────────────────────────
JWT_SECRET=your_super_secure_jwt_secret_key_here

# ──────────────────────────────────────────────
# Node Environment (development | production)
# ──────────────────────────────────────────────
NODE_ENV=development

# ──────────────────────────────────────────────
# Frontend URL for CORS (comma-separated for multiple origins)
# ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000,https://prabandh-jai-verse.vercel.app
