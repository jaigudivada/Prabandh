# ──────────────────────────────────────────────
# Frontend Environment Variables
# ──────────────────────────────────────────────

# API Base URL
# Development (Vite proxy handles /api → http://localhost:5000):
#   Leave empty: VITE_API_URL=
#
# Production (Vercel multi-service):
#   VITE_API_URL=/_/backend
#
# Standalone (direct backend URL):
#   VITE_API_URL=http://localhost:5000
#
VITE_API_URL=